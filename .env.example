# Prisma resolves relative SQLite paths from the directory containing prisma.config.ts (the project root).
# Therefore file:./dev.db means <project-root>/dev.db, while this local example uses <project-root>/prisma/dev.db.
DATABASE_URL="file:./prisma/dev.db"

# For production, use an absolute path, for example:
# DATABASE_URL="file:/srv/unibridge/data/unibridge.sqlite"

# Leave empty locally; set a generated secret of at least 32 characters in production.
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=false
APP_URL="http://localhost:3000"

# Enable only when the app is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY=false

EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="UniBridge <no-reply@unibridge.id.vn>"

# Optional in development; production must use an absolute directory.
UPLOADS_DIR=
# Production example: UPLOADS_DIR="/srv/unibridge/uploads"

# Development/demo seed only. Do not set this on production.
SEED_USER_PASSWORD=

# Server-only AI provider configuration. Never use NEXT_PUBLIC_ for these values.
AI_API_KEY=
AI_API_URL=
AI_MODEL=
# Automatic Problem review is enabled unless explicitly disabled.
AI_AUTO_REVIEW=true
