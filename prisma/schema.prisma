generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  passwordHash      String
  role              String             @default("STUDENT")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  businessProfile   BusinessProfile?
  studentProfile    StudentProfile?
  ownedTeam         StudentTeam?       @relation("StudentTeamOwner")
  reviewedProblems  Problem[]          @relation("ProblemReviewer")
  reviews           Review[]
  notifications     Notification[]
  savedProblems     SavedProblem[]
  problemViews      ViewLog[]
  problemSearches   SearchLog[]
  workspaceMessages WorkspaceMessage[]
}

model BusinessProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  companyName String
  industry    String
  website     String?
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problems    Problem[]
}

model StudentProfile {
  id          String           @id @default(cuid())
  userId      String           @unique
  major       String
  university  String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships TeamMembership[]
}

model StudentTeam {
  id               String           @id @default(cuid())
  ownerId          String?          @unique
  name             String
  slug             String           @unique
  university       String
  description      String
  experience       String           @default("")
  relevantProducts String           @default("")
  achievements     String           @default("")
  interests        String           @default("")
  ratingAverage    Float            @default(0)
  ratingCount      Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  owner            User?            @relation("StudentTeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships      TeamMembership[]
  skills           TeamSkill[]
  applications     Application[]
  projects         Project[]
  reviews          Review[]
}

model TeamMembership {
  id               String          @id @default(cuid())
  teamId           String
  studentProfileId String?
  name             String          @default("")
  major            String          @default("")
  title            String
  isLead           Boolean         @default(false)
  joinedAt         DateTime        @default(now())
  team             StudentTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([teamId, studentProfileId])
}

model Skill {
  id            String         @id @default(cuid())
  name          String         @unique
  teamSkills    TeamSkill[]
  problemSkills ProblemSkill[]
}

model TeamSkill {
  teamId  String
  skillId String
  team    StudentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  skill   Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([teamId, skillId])
}

model Problem {
  id                String              @id @default(cuid())
  businessProfileId String
  reviewedById      String?
  title             String
  slug              String              @unique
  description       String
  goal              String
  field             String
  requirements      String
  expectedDuration  String
  budgetMin         Int?
  budgetMax         Int?
  status            String              @default("PENDING_REVIEW")
  reviewNote        String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  businessProfile   BusinessProfile     @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  reviewer          User?               @relation("ProblemReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  skills            ProblemSkill[]
  applications      Application[]
  attachments       ProblemAttachment[]
  workspaceMessages WorkspaceMessage[]
  savedBy           SavedProblem[]
  viewLogs          ViewLog[]

  @@index([status, field])
  @@index([businessProfileId])
}

model ProblemAttachment {
  id           String   @id @default(cuid())
  problemId    String
  originalName String
  contentType  String
  sizeBytes    Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model ProblemSkill {
  problemId String
  skillId   String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([problemId, skillId])
}

model Application {
  id                   String            @id @default(cuid())
  problemId            String
  teamId               String
  approach             String
  problemUnderstanding String            @default("")
  solutionDirection    String            @default("")
  methodology          String            @default("")
  keySteps             String            @default("")
  tools                String            @default("")
  resources            String            @default("")
  estimatedDuration    String
  proposedBudget       Int?
  status               String            @default("SUBMITTED")
  submittedAt          DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  problem              Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  team                 StudentTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  solutionProposal     SolutionProposal?
  proposals            Proposal[]
  project              Project?

  @@unique([problemId, teamId])
  @@index([status])
}

model SavedProblem {
  userId    String
  problemId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([userId, problemId])
  @@index([userId, createdAt])
}

model ViewLog {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, createdAt])
}

model SearchLog {
  id        String   @id @default(cuid())
  userId    String
  query     String   @default("")
  field     String?
  skill     String?
  duration  String?
  budgetMin Int?
  budgetMax Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SolutionProposal {
  id            String      @id @default(cuid())
  applicationId String      @unique
  content       String
  prototypeUrl  String?
  status        String      @default("SUBMITTED")
  submittedAt   DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Proposal {
  id            String               @id @default(cuid())
  applicationId String
  version       Int
  type          String
  description   String
  status        String               @default("SUBMITTED")
  submittedAt   DateTime             @default(now())
  createdAt     DateTime             @default(now())
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  files         ProposalFile[]
  evaluations   ProposalEvaluation[]

  @@unique([applicationId, version])
  @@index([applicationId, submittedAt])
}

model ProposalFile {
  id           String   @id @default(cuid())
  proposalId   String
  originalName String
  contentType  String
  sizeBytes    Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model WorkspaceMessage {
  id        String   @id @default(cuid())
  problemId String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([problemId, createdAt])
}

model ProposalEvaluation {
  id                      String   @id @default(cuid())
  proposalId              String
  problemResponse         Int
  feasibility             Int
  goalAlignment           Int
  practicalImplementation Int
  estimatedCost           Int
  implementationTime      Int
  valueDelivered          Int
  comment                 String
  decision                String
  createdAt               DateTime @default(now())
  proposal                Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

model Project {
  id              String               @id @default(cuid())
  applicationId   String               @unique
  teamId          String
  title           String
  agreedScope     String
  totalAmount     Int
  platformFeeRate Float                @default(0.15)
  status          String               @default("IN_PROGRESS")
  startedAt       DateTime             @default(now())
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  application     Application          @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  team            StudentTeam          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  milestones      Milestone[]
  transactions    ProjectTransaction[]
  reviews         Review[]
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String
  amount      Int?
  dueAt       DateTime?
  sortOrder   Int
  status      String    @default("PENDING")
  submittedAt DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sortOrder])
}

model ProjectTransaction {
  id          String    @id @default(cuid())
  projectId   String
  amount      Int
  platformFee Int
  status      String    @default("PENDING")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Review {
  id             String      @id @default(cuid())
  projectId      String
  reviewerId     String
  reviewedTeamId String
  rating         Int
  content        String
  createdAt      DateTime    @default(now())
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer       User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedTeam   StudentTeam @relation(fields: [reviewedTeamId], references: [id], onDelete: Cascade)

  @@unique([projectId, reviewerId])
  @@index([reviewedTeamId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
