generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                String                      @id @default(cuid())
  email                             String                      @unique
  name                              String
  passwordHash                      String
  role                              String                      @default("STUDENT")
  accountStatus                     String                      @default("ACTIVE")
  authVersion                       Int                         @default(0)
  lastLoginAt                       DateTime?
  lockedAt                          DateTime?
  lockReason                        String?
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime                    @updatedAt
  businessProfile                   BusinessProfile?
  studentProfile                    StudentProfile?
  ownedTeam                         StudentTeam?                @relation("StudentTeamOwner")
  reviewedProblems                  Problem[]                   @relation("ProblemReviewer")
  reviews                           Review[]
  notifications                     Notification[]
  savedProblems                     SavedProblem[]
  problemViews                      ViewLog[]
  problemSearches                   SearchLog[]
  workspaceMessages                 WorkspaceMessage[]
  milestoneSubmissions              MilestoneSubmission[]
  platformCharges                   PlatformCharge[]            @relation("PlatformChargeBuyer")
  createdTrialBriefVersions         TrialBriefVersion[]         @relation("TrialBriefVersionCreator")
  trialBriefResponses               TrialBriefResponse[]        @relation("TrialBriefResponseUser")
  submittedProposalAttempts         ProposalSubmissionAttempt[] @relation("ProposalSubmissionUser")
  submittedProposals                Proposal[]                  @relation("ProposalSubmitter")
  reviewedProposalHandoffs          ProposalHandoffReview[]     @relation("ProposalHandoffReviewer")
  prototypeClosures                 PrototypeClosure[]          @relation("PrototypeClosureActor")
  acceptedFinalProjects             Project[]                   @relation("ProjectFinalAccepter")
  createdAgreementVersions          ProjectAgreementVersion[]   @relation("AgreementVersionCreator")
  businessAcceptedAgreementVersions ProjectAgreementVersion[]   @relation("AgreementVersionBusinessAccepter")
  teamAcceptedAgreementVersions     ProjectAgreementVersion[]   @relation("AgreementVersionTeamAccepter")
  milestoneProgressUpdates          MilestoneProgressUpdate[]
  requestedProjectChanges           ProjectChangeRequest[]
  projectWorkflowEvents             ProjectWorkflowEvent[]
  projectSupportNotes               ProjectSupportNote[]
  auditLogs                         AuditLog[]                  @relation("AuditLogActor")
  reports                           Report[]                    @relation("ReportReporter")
  handledReports                    Report[]                    @relation("ReportHandler")
  passwordResetTokens               PasswordResetToken[]
  workspaceReadCursors              WorkspaceReadCursor[]
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model RateLimitBucket {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Report {
  id               String    @id @default(cuid())
  reporterId       String
  handlerId        String?
  targetType       String
  targetId         String
  snapshot         String
  reason           String
  status           String    @default("NEW")
  resolutionReason String?
  contentHidden    Boolean   @default(false)
  openKey          String?   @unique
  handledAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  reporter         User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  handler          User?     @relation("ReportHandler", fields: [handlerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId, createdAt])
}

model BusinessProfile {
  id              String                  @id @default(cuid())
  userId          String                  @unique
  companyName     String
  industry        String
  industries      String                  @default("")
  logo            String?
  logoMimeType   String?
  website         String?
  description     String
  address         String                  @default("")
  contactEmail    String?
  phone           String?
  representative  String                  @default("")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problems        Problem[]
  invitations     ApplicationInvitation[] @relation("BusinessInvitations")
  reviews         Review[]                @relation("ReviewedBusiness")
  postCredits     PostCredit[]
  subscriptions   Subscription[]
  platformCharges PlatformCharge[]
  aiUsages        AiUsage[]
  aiUsageBuckets  AiUsageBucket[]
}

model AiUsage {
  id                String          @id @default(cuid())
  businessProfileId String?
  quotaKey          String           @default("BUSINESS")
  targetId          String?
  feature           String
  status            String          @default("RESERVED")
  createdAt         DateTime        @default(now())
  completedAt       DateTime?
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@index([quotaKey, feature, targetId, status, createdAt])
}

model AiUsageBucket {
  id                String          @id @default(cuid())
  businessProfileId String?
  quotaKey          String           @default("BUSINESS")
  periodType        String
  periodStart       DateTime
  used              Int             @default(0)
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@unique([quotaKey, periodType, periodStart])
  @@index([quotaKey, periodType, periodStart])
}

model StudentProfile {
  id          String           @id @default(cuid())
  userId      String           @unique
  major       String
  university  String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships TeamMembership[]
}

model StudentTeam {
  id               String                  @id @default(cuid())
  ownerId          String?                 @unique
  name             String
  slug             String                  @unique
  university       String
  description      String
  experience       String                  @default("")
  relevantProducts String                  @default("")
  achievements     String                  @default("")
  interests        String                  @default("")
  hiddenByAdmin    Boolean                 @default(false)
  ratingAverage    Float                   @default(0)
  ratingCount      Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  owner            User?                   @relation("StudentTeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships      TeamMembership[]
  skills           TeamSkill[]
  applications     Application[]
  invitations      ApplicationInvitation[]
  projects         Project[]
  reviews          Review[]                @relation("ReviewedTeam")
  portfolioItems   PortfolioItem[]
}

model TeamMembership {
  id               String          @id @default(cuid())
  teamId           String
  studentProfileId String?
  name             String          @default("")
  major            String          @default("")
  title            String
  isLead           Boolean         @default(false)
  joinedAt         DateTime        @default(now())
  team             StudentTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([teamId, studentProfileId])
}

model Skill {
  id            String         @id @default(cuid())
  name          String         @unique
  teamSkills    TeamSkill[]
  problemSkills ProblemSkill[]
}

model TeamSkill {
  teamId  String
  skillId String
  team    StudentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  skill   Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([teamId, skillId])
}

model Problem {
  id                            String                  @id @default(cuid())
  businessProfileId             String
  reviewedById                  String?
  title                         String
  slug                          String                  @unique
  description                   String
  goal                          String
  field                         String
  requirements                  String
  expectedDuration              String
  budgetMin                     Int?
  budgetMax                     Int?
  status                        String                  @default("PENDING_REVIEW")
  closedReason                  String?
  closedAt                      DateTime?
  hiddenByAdmin                 Boolean                 @default(false)
  reviewNote                    String?
  submittedAt                   DateTime?
  approvedAt                    DateTime?
  firstApprovedAt               DateTime?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  version                       Int                     @default(1)
  businessProfile               BusinessProfile         @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  reviewer                      User?                   @relation("ProblemReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  skills                        ProblemSkill[]
  applications                  Application[]
  attachments                   ProblemAttachment[]
  workspaceMessages             WorkspaceMessage[]
  savedBy                       SavedProblem[]
  viewLogs                      ViewLog[]
  invitations                   ApplicationInvitation[]
  consumedCreditId              String?
  creditRefundedAt              DateTime?
  prototypeLegacy               Boolean                 @default(false)
  evaluationResult              String?
  implementationDecision        String?
  prototypeRevisionRequestCount Int                     @default(0)
  trialBriefLockedAt            DateTime?
  consumedCredit                PostCredit?             @relation(fields: [consumedCreditId], references: [id])
  trialBriefVersions            TrialBriefVersion[]
  proposalHandoffReviews        ProposalHandoffReview[]
  prototypeClosures             PrototypeClosure[]
  aiReviews                     AiReview[]

  @@index([status, field])
  @@index([businessProfileId])
  @@index([consumedCreditId])
}

model AiReview {
  id            String   @id @default(cuid())
  problemId     String?
  attemptId     String?
  feature       String
  actor         String   @default("AI")
  status        String
  conclusion    String?
  checklist     Json
  reason        String?
  problemVersion Int?
  createdAt     DateTime @default(now())
  problem       Problem? @relation(fields: [problemId], references: [id], onDelete: Cascade)
  attempt       ProposalSubmissionAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([problemId, feature, createdAt])
  @@index([attemptId, feature, createdAt])
}

model PostCredit {
  id                String          @id @default(cuid())
  businessProfileId String
  source            String
  remaining         Int
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  consumedProblems  Problem[]

  @@index([businessProfileId, source, expiresAt])
}

model Subscription {
  id                String          @id @default(cuid())
  businessProfileId String
  package           String
  startsAt          DateTime
  endsAt            DateTime
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@unique([businessProfileId, package])
  @@index([businessProfileId, status, endsAt])
}

model PlatformCharge {
  id                String          @id @default(cuid())
  businessProfileId String
  buyerId           String
  type              String
  amount            Int
  units             Int
  quantity          Int?
  periodStartsAt    DateTime?
  periodEndsAt      DateTime?
  idempotencyKey    String          @unique
  createdAt         DateTime        @default(now())
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  buyer             User            @relation("PlatformChargeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([businessProfileId, createdAt])
  @@index([type, createdAt])
}

model ProblemAttachment {
  id           String   @id @default(cuid())
  problemId    String
  originalName String
  contentType  String
  sizeBytes    Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model ProblemSkill {
  problemId String
  skillId   String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([problemId, skillId])
}

model Application {
  id                     String                  @id @default(cuid())
  problemId              String
  teamId                 String
  approach               String
  problemUnderstanding   String                  @default("")
  solutionDirection      String                  @default("")
  methodology            String                  @default("")
  keySteps               String                  @default("")
  tools                  String                  @default("")
  resources              String                  @default("")
  estimatedDuration      String
  proposedBudget         Int?
  status                 String                  @default("SUBMITTED")
  submittedAt            DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  profileSnapshot        Json?
  profileSnapshotVersion Int                     @default(1)
  approachLinks          Json?
  attachmentVersion      Int                     @default(0)
  needsReview            Boolean                 @default(false)
  businessReviewNote     String?
  problem                Problem                 @relation(fields: [problemId], references: [id], onDelete: Cascade)
  team                   StudentTeam             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitations            ApplicationInvitation[]
  approachAttachments    ApproachAttachment[]
  solutionProposal       SolutionProposal?
  proposals              Proposal[]
  project                Project?
  workspaceMessages      WorkspaceMessage[]
  workspaceReadCursors   WorkspaceReadCursor[]

  @@unique([problemId, teamId])
  @@index([status])
}

model ApproachAttachment {
  id               String      @id @default(cuid())
  applicationId    String
  submissionVersion Int
  originalName     String
  contentType      String
  sizeBytes        Int
  storageKey       String      @unique
  createdAt        DateTime    @default(now())
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, submissionVersion])
}

model ApplicationInvitation {
  id                         String          @id @default(cuid())
  applicationId              String
  problemId                  String
  teamId                     String
  invitedByBusinessProfileId String
  status                     String          @default("PENDING_CONFIRMATION")
  expiresAt                  DateTime
  reminderAt                 DateTime?
  reminderSentAt             DateTime?
  invitedAt                  DateTime        @default(now())
  respondedAt                DateTime?
  responseStatus             String?
  responseReason             String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  application                Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  problem                    Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  team                       StudentTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedByBusinessProfile   BusinessProfile @relation("BusinessInvitations", fields: [invitedByBusinessProfileId], references: [id], onDelete: Restrict)

  @@index([problemId, status, expiresAt])
  @@index([applicationId, status])
}

model SavedProblem {
  userId    String
  problemId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([userId, problemId])
  @@index([userId, createdAt])
}

model ViewLog {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, createdAt])
}

model SearchLog {
  id        String   @id @default(cuid())
  userId    String
  query     String   @default("")
  field     String?
  skill     String?
  duration  String?
  budgetMin Int?
  budgetMax Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SolutionProposal {
  id            String      @id @default(cuid())
  applicationId String      @unique
  content       String
  prototypeUrl  String?
  status        String      @default("SUBMITTED")
  submittedAt   DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Proposal {
  id                 String                      @id @default(cuid())
  applicationId      String
  version            Int
  type               String
  description        String
  status             String                      @default("SUBMITTED")
  submissionStatus   String                      @default("NOT_SUBMITTED")
  handoffStatus      String                      @default("NOT_SUBMITTED")
  submittedByUserId  String?
  lastResubmittedAt  DateTime?
  submittedAt        DateTime                    @default(now())
  createdAt          DateTime                    @default(now())
  application        Application                 @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  files              ProposalFile[]
  evaluations        ProposalEvaluation[]
  submissionAttempts ProposalSubmissionAttempt[]
  handoffReviews     ProposalHandoffReview[]
  submittedBy        User?                       @relation("ProposalSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@unique([applicationId, version])
  @@index([applicationId, submittedAt])
}

model ProposalFile {
  id           String                     @id @default(cuid())
  proposalId   String
  attemptId    String?
  originalName String
  contentType  String
  sizeBytes    Int
  storageKey   String                     @unique
  createdAt    DateTime                   @default(now())
  proposal     Proposal                   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  attempt      ProposalSubmissionAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([proposalId])
}

model WorkspaceMessage {
  id            String       @id @default(cuid())
  problemId     String
  applicationId String?
  senderId      String
  content       String
  hiddenByAdmin Boolean      @default(false)
  createdAt     DateTime     @default(now())
  problem       Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  sender        User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([problemId, createdAt])
  @@index([applicationId, createdAt])
}

model WorkspaceReadCursor {
  id            String      @id @default(cuid())
  applicationId String
  userId        String
  lastReadAt    DateTime?
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([applicationId, userId])
}

model PortfolioItem {
  id              String      @id @default(cuid())
  teamId          String
  sourceProjectId String?     @unique
  title           String
  description     String
  demoUrl         String?
  fileStorageKey  String?
  fileName        String?
  field           String      @default("")
  isVisible       Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  team            StudentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sourceProject   Project?    @relation(fields: [sourceProjectId], references: [id], onDelete: SetNull)

  @@index([teamId, isVisible])
}

model ProposalEvaluation {
  id                      String   @id @default(cuid())
  proposalId              String
  problemResponse         Int
  feasibility             Int
  goalAlignment           Int
  practicalImplementation Int
  estimatedCost           Int
  implementationTime      Int
  valueDelivered          Int
  comment                 String
  decision                String
  evaluationResult        String?
  implementationDecision  String?
  revisionRequestNumber   Int?
  createdAt               DateTime @default(now())
  proposal                Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

model TrialBriefVersion {
  id                   String               @id @default(cuid())
  problemId            String
  version              Int
  objective            String
  scope                String
  deliverables         String
  deadline             DateTime
  evaluationCriteria   String
  maxRevisionRequests  Int
  businessProvidedData String?
  confidentialityTerms String
  ownershipTerms       String
  compensationTerms    String?
  createdByUserId      String
  createdAt            DateTime             @default(now())
  lockedAt             DateTime?
  problem              Problem              @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdBy            User                 @relation("TrialBriefVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  responses            TrialBriefResponse[]

  @@unique([problemId, version])
}

model TrialBriefResponse {
  id                  String            @id @default(cuid())
  trialBriefVersionId String
  party               String
  decision            String
  note                String?
  respondedByUserId   String
  respondedAt         DateTime          @default(now())
  trialBriefVersion   TrialBriefVersion @relation(fields: [trialBriefVersionId], references: [id], onDelete: Cascade)
  respondedBy         User              @relation("TrialBriefResponseUser", fields: [respondedByUserId], references: [id], onDelete: Restrict)

  @@unique([trialBriefVersionId, party])
}

model ProposalSubmissionAttempt {
  id                String                  @id @default(cuid())
  proposalId        String
  attempt           Int
  submittedByUserId String
  description       String
  submittedAt       DateTime                @default(now())
  proposal          Proposal                @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  submittedBy       User                    @relation("ProposalSubmissionUser", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  files             ProposalFile[]
  handoffReviews    ProposalHandoffReview[]
  aiReviews         AiReview[]

  @@unique([proposalId, attempt])
  @@index([proposalId, submittedAt])
}

model ProposalHandoffReview {
  id                    String                     @id @default(cuid())
  problemId             String
  proposalId            String
  attemptId             String?
  reviewedByUserId      String
  filesOrLinksComplete  Boolean
  withinTrialBriefScope Boolean
  compliesWithRules     Boolean
  note                  String
  missingItems          String?
  result                String
  createdAt             DateTime                   @default(now())
  problem               Problem                    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  proposal              Proposal                   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  attempt               ProposalSubmissionAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  reviewedBy            User                       @relation("ProposalHandoffReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([problemId, createdAt])
  @@index([proposalId, createdAt])
}

model PrototypeClosure {
  id        String   @id @default(cuid())
  problemId String
  actorId   String
  reason    String
  result    String
  createdAt DateTime @default(now())
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  actor     User     @relation("PrototypeClosureActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([problemId, createdAt])
}

model Project {
  id                        String                    @id @default(cuid())
  applicationId             String                    @unique
  teamId                    String
  title                     String
  agreedScope               String
  deliverables              String                    @default("")
  duration                  String                    @default("")
  totalAmount               Int
  generalAcceptanceCriteria String                    @default("")
  businessResponsibilities  String                    @default("")
  teamResponsibilities      String                    @default("")
  paymentMethod             String                    @default("")
  revisionNote              String?
  agreementRevision         Int                       @default(1)
  businessAcceptedAt        DateTime?
  teamAcceptedAt            DateTime?
  status                    String                    @default("AGREEING")
  startedAt                 DateTime?
  completedAt               DateTime?
  cancelledAt               DateTime?
  legacyTermsExempt         Boolean                   @default(false)
  finalAcceptanceStatus     String                    @default("NOT_REQUESTED")
  finalAcceptedAt           DateTime?
  finalAcceptedById         String?
  pausedAt                  DateTime?
  pausedTotalSeconds        Int                       @default(0)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  portfolioItem             PortfolioItem?
  application               Application               @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  team                      StudentTeam               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  finalAcceptedBy           User?                     @relation("ProjectFinalAccepter", fields: [finalAcceptedById], references: [id], onDelete: SetNull)
  milestones                Milestone[]
  transactions              ProjectTransaction[]
  reviews                   Review[]
  agreementVersions         ProjectAgreementVersion[]
  changeRequests            ProjectChangeRequest[]
  workflowEvents            ProjectWorkflowEvent[]
  supportNotes              ProjectSupportNote[]
}

model Milestone {
  id                 String                    @id @default(cuid())
  projectId          String
  title              String
  description        String
  acceptanceCriteria String                    @default("")
  paymentPercent     Int                       @default(0)
  amount             Int?
  dueAt              DateTime?
  sortOrder          Int
  status             String                    @default("PENDING")
  submittedAt        DateTime?
  acceptedAt         DateTime?
  progressNote       String?
  revisionFeedback   String?
  progressPercent    Int                       @default(0)
  workCompleted      String                    @default("")
  difficulties       String                    @default("")
  acceptanceStatus   String                    @default("NOT_SUBMITTED")
  paymentStatus      String                    @default("UNFUNDED")
  revisionCount      Int                       @default(0)
  responseDueAt      DateTime?
  overdueSince       DateTime?
  pausedAt           DateTime?
  pausedTotalSeconds Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions        MilestoneSubmission[]
  transactions       ProjectTransaction[]
  progressUpdates    MilestoneProgressUpdate[]
  changeRequests     ProjectChangeRequest[]
  workflowEvents     ProjectWorkflowEvent[]
  supportNotes       ProjectSupportNote[]

  @@unique([projectId, sortOrder])
}

model ProjectTransaction {
  id                     String     @id @default(cuid())
  projectId              String
  milestoneId            String?
  idempotencyKey         String?    @unique
  type                   String     @default("DEPOSIT")
  amount                 Int
  platformFee            Int
  platformFeeBasisPoints Int        @default(0)
  businessFeeBasisPoints Int?
  studentFeeBasisPoints  Int?
  businessFee            Int?
  status                 String     @default("PENDING")
  paidAt                 DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  project                Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone              Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  @@index([projectId, type, status])
}

model MilestoneSubmission {
  id            String                    @id @default(cuid())
  milestoneId   String
  submittedById String
  note          String
  links         String                    @default("[]")
  createdAt     DateTime                  @default(now())
  milestone     Milestone                 @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submittedBy   User                      @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  files         MilestoneSubmissionFile[]

  @@index([milestoneId, createdAt])
}

model MilestoneSubmissionFile {
  id           String              @id @default(cuid())
  submissionId String
  originalName String
  contentType  String
  sizeBytes    Int
  storageKey   String              @unique
  createdAt    DateTime            @default(now())
  submission   MilestoneSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model ProjectAgreementVersion {
  id                        String    @id @default(cuid())
  projectId                 String
  versionNumber             Int
  status                    String
  title                     String
  agreedScope               String
  deliverables              String
  duration                  String
  totalAmount               Int
  generalAcceptanceCriteria String
  businessResponsibilities  String
  teamResponsibilities      String
  paymentMethod             String
  maxMilestoneRevisions     Int
  ownershipTerms            String
  usageTerms                String
  confidentialityTerms      String
  extensionTerms            String
  suspensionTerms           String
  terminationTerms          String
  disputeTerms              String
  milestonesSnapshot        String
  createdByUserId           String
  businessAcceptedAt        DateTime?
  teamAcceptedAt            DateTime?
  businessAcceptedByUserId  String?
  teamAcceptedByUserId      String?
  legacySnapshot            Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  project                   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy                 User      @relation("AgreementVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  businessAcceptedBy        User?     @relation("AgreementVersionBusinessAccepter", fields: [businessAcceptedByUserId], references: [id], onDelete: SetNull)
  teamAcceptedBy            User?     @relation("AgreementVersionTeamAccepter", fields: [teamAcceptedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, versionNumber])
  @@index([projectId, createdAt])
}

model MilestoneProgressUpdate {
  id              String    @id @default(cuid())
  milestoneId     String
  progressPercent Int
  workCompleted   String
  difficulties    String
  createdByUserId String
  createdAt       DateTime  @default(now())
  milestone       Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  createdBy       User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([milestoneId, createdAt])
}

model ProjectChangeRequest {
  id                 String               @id @default(cuid())
  projectId          String
  milestoneId        String?
  kind               String
  status             String
  reason             String
  payloadJson        String               @default("{}")
  proposedDueAt      DateTime?
  requestedByUserId  String
  businessAcceptedAt DateTime?
  teamAcceptedAt     DateTime?
  idempotencyKey     String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  resolvedAt         DateTime?
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone          Milestone?           @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  requestedBy        User                 @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  supportNotes       ProjectSupportNote[]

  @@index([projectId, status, createdAt])
  @@index([milestoneId, status])
}

model ProjectWorkflowEvent {
  id             String     @id @default(cuid())
  projectId      String
  milestoneId    String?
  actorUserId    String?
  eventType      String
  fromStatus     String?
  toStatus       String?
  detailsJson    String     @default("{}")
  idempotencyKey String?    @unique
  createdAt      DateTime   @default(now())
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  actor          User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([milestoneId, createdAt])
}

model ProjectSupportNote {
  id              String                @id @default(cuid())
  projectId       String
  milestoneId     String?
  changeRequestId String?
  adminUserId     String
  note            String
  createdAt       DateTime              @default(now())
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone       Milestone?            @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  changeRequest   ProjectChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  admin           User                  @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model Review {
  id                        String           @id @default(cuid())
  projectId                 String
  reviewerId                String
  direction                 String           @default("BUSINESS_TO_TEAM")
  reviewedTeamId            String?
  reviewedBusinessProfileId String?
  rating                    Float
  criteriaScores            String           @default("{}")
  content                   String
  hiddenByAdmin             Boolean          @default(false)
  createdAt                 DateTime         @default(now())
  project                   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer                  User             @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedTeam              StudentTeam?     @relation("ReviewedTeam", fields: [reviewedTeamId], references: [id], onDelete: Cascade)
  reviewedBusinessProfile   BusinessProfile? @relation("ReviewedBusiness", fields: [reviewedBusinessProfileId], references: [id], onDelete: Cascade)

  @@unique([projectId, direction])
  @@index([reviewedTeamId, createdAt])
  @@index([reviewedBusinessProfileId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  dedupeKey String?   @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
